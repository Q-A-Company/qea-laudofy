PORT=3333
CORS_ORIGIN=http://localhost:5173

# Service role key: acesso privilegiado (bypassa RLS). Nunca expor no frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Connection string direta do Postgres (Project Settings > Database > Connection
# string > URI). Use o modo "Session pooler" (porta 5432), não o "Transaction"
# (6543) - o pg-boss precisa de conexão em modo sessão.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<host>:5432/postgres

# Classificação de fotos: sem essa chave, usa um classificador mock (categoria
# aleatória) - útil pra testar o pipeline sem gastar crédito de API.
ANTHROPIC_API_KEY=
